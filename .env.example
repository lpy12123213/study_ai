# OpenRouter API 配置
OPENROUTER_API_KEY=your_api_key_here
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# 对话模型供应商（openrouter / fireworks）
# - openrouter：使用 OPENROUTER_API_KEY + OPENROUTER_BASE_URL
# - fireworks：使用 FIREWORKS_API_KEY + FIREWORKS_BASE_URL
CHAT_PROVIDER=fireworks

# 审卷人供应商（openrouter / fireworks）
REVIEW_PROVIDER=openrouter

# Fireworks AI 配置（当 REVIEW_PROVIDER=fireworks 时使用）
FIREWORKS_API_KEY=your_fireworks_key_here
FIREWORKS_BASE_URL=https://api.fireworks.ai/inference/v1

# 模型配置
# 主AI模型（用于对话和工具调用编排）
MAIN_MODEL=accounts/fireworks/models/deepseek-v3p2
# 子AI模型（用于题目选择）
SUB_MODEL=accounts/fireworks/models/deepseek-v3p2

# 模型参数配置
# 主AI参数
MAIN_MODEL_TEMPERATURE=0.7
MAIN_MODEL_MAX_TOKENS=2000

# 子AI参数
SUB_MODEL_TEMPERATURE=0.3
SUB_MODEL_MAX_TOKENS=1000

# 对话配置
MAX_TOOL_ITERATIONS=10

# 爬虫配置
DEFAULT_SUBJECT=高中数学
# 难度过滤模式（multi 默认，多档；single 严格单档）
DIFFICULTY_QUERY_MODE=multi

# 超时配置（秒）
API_TIMEOUT=120
SUB_AI_TIMEOUT=60

# Reviewer (OpenRouter) - for MCP tool review_paper
REVIEW_MODEL=openai/gpt-4o-mini
REVIEW_MODEL_TEMPERATURE=0.2
REVIEW_MODEL_MAX_TOKENS=1800
REVIEW_TIMEOUT=90
REVIEW_MAX_STEM_CHARS=900
REVIEW_HTTP_REFERER=http://localhost:8000
REVIEW_X_TITLE=Exam Paper Assistant - Reviewer

# Zhipu BigModel (for MCP tool: web_search)
ZHIPU_API_KEY=your_zhipu_api_key_here
ZHIPU_BASE_URL=https://open.bigmodel.cn/api/paas/v4
ZHIPU_MODEL=glm-4.5
ZHIPU_TIMEOUT=60

# Metaso AI Search（用于自学资料：web_search_knowledge）
# - 优先使用 METASO_API_KEY；兼容别名 METASO_API
# - 官方 API base_url 默认：https://metaso.cn/api/v1
METASO_API_KEY=
# METASO_API=
METASO_BASE_URL=https://metaso.cn/api/v1
METASO_TIMEOUT=30

# Metaso /ask（直接问答，返回 answer + sources）
# - study-materials 默认已切到 ask（可用 STUDY_MATERIALS_METASO_MODE=search 回退到 /search）
STUDY_MATERIALS_METASO_MODE=ask
# /ask 的输出格式（目前 simple/direct/markdown/text/raw 都可用；默认 simple）
METASO_ASK_FORMAT=simple
# 可选：指定 Metaso 侧模型（留空用默认）
METASO_ASK_MODEL=

# 当主写作模型未配置/不可用时：是否用 Metaso /ask 作为“写作兜底”（仍需 METASO_API_KEY）
STUDY_MATERIALS_METASO_WRITER_FALLBACK=1

# Zhihu（可选）：用于抓取需要登录态的知乎文章/回答（DeepResearch 会自动使用）
# 提示：复制浏览器请求头里的 Cookie 字符串即可；不要提交到 Git。
ZHIHU_COOKIES=

# ======================
# Web UI 登录（JWT）
# ======================
# 说明：
# - Web UI 的「对话」功能需要登录后才能使用
# - 登录成功后前端会把 token 持久化在浏览器 localStorage（默认 key: auth-storage）
#
# 建议：开发/本地环境可以先用默认值；生产环境务必修改 JWT_SECRET 与管理员密码。

# JWT 密钥（生产环境请修改为随机长字符串）
JWT_SECRET=dev-jwt-secret-change-me

# Token 过期时间（小时）
JWT_EXPIRE_HOURS=24

# 默认管理员账号（用于后台内置用户：无需数据库）
ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin123
ADMIN_ROLE=admin

# ======================
# 自学资料（study-materials）
# ======================
# 是否启用百科/网页正文/StackExchange/GitHub 等额外检索工具
STUDY_MATERIALS_ENABLE_EXTRA_TOOLS=0

# 是否启用题库（例题/练习题）。默认关闭，先专注概念与理解。
STUDY_MATERIALS_ENABLE_QUESTIONS=0

# 默认生成预设（可选）：quick | standard | deep | research
# - standard：平衡（默认）
# - deep：更深入（多源 + 更长讲解）
# - research：研究型（多轮检索 + 更严格的条件/反例/推导覆盖，可能更慢）
# STUDY_MATERIALS_PRESET=standard

# foreach_knowledge_point 子代理并发（提升生成速度，但并发过高可能触发限流）
STUDY_MATERIALS_SUBAGENT_CONCURRENCY=3

# 子代理检索策略：先“思考拆分”再逐问 Metaso /ask（提升资料质量，避免只问一个大问题）
# - 是否拆分：默认开启
STUDY_MATERIALS_WEB_DECOMPOSE=1
# - 每个知识点拆成几个子问题（2-6，默认 4）
STUDY_MATERIALS_WEB_SUBQUERIES=4

# 子代理“思考/拆分”模型（默认使用 SUB_MODEL；可单独指定）
STUDY_MATERIALS_THINKING_MODEL=accounts/fireworks/models/deepseek-v3p2
# 子代理“写作/讲解”模型（默认使用 SUB_MODEL；可单独指定更强模型）
STUDY_MATERIALS_WRITER_MODEL=accounts/fireworks/models/deepseek-v3p2

# OpenRouter only：开启 reasoning/thinking（low/medium/high），exclude=1 表示不输出思考过程
# STUDY_MATERIALS_THINKING_MODE=1
# STUDY_MATERIALS_THINKING_EFFORT=medium
STUDY_MATERIALS_REASONING_EXCLUDE=1

# 单个工具步骤超时（秒）：避免偶发卡住无响应
STUDY_MATERIALS_STEP_TIMEOUT_S=240

# one-shot 提升：当 LLM 审查未通过时，自动执行一次“修订 + 复审”（无需进入下一轮规划）
STUDY_MATERIALS_AUTO_REVISE=1

# 自主性提升：当启发式审查判定“资料来源不足”时，自动对问题知识点追加一轮检索+再生成（一次性补齐）
STUDY_MATERIALS_AUTO_RESEARCH=1
# 最多对多少个“资料不足”的知识点做自动补检索（避免爆炸式调用）
STUDY_MATERIALS_AUTO_RESEARCH_MAX_POINTS=3

# SSE 心跳间隔（秒）：长工具调用期间保持前端有输出，避免“无输出假死”
STUDY_MATERIALS_SSE_HEARTBEAT_S=4

# 任务保留时间（秒）：用于浏览器刷新后续流/恢复
STUDY_MATERIALS_TASK_TTL_S=3600

# 任务池容量（内存）
STUDY_MATERIALS_MAX_TASKS=50
STUDY_MATERIALS_TASK_MAX_EVENTS=8000
