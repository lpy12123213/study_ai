# OpenRouter API 配置
OPENROUTER_API_KEY=your_api_key_here
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# Moonshot 官方 API 配置（OpenAI-compatible）
MOONSHOT_API_KEY=your_moonshot_key_here
MOONSHOT_BASE_URL=https://api.moonshot.cn/v1

# 对话模型供应商（openrouter / fireworks / moonshot）
# - openrouter：使用 OPENROUTER_API_KEY + OPENROUTER_BASE_URL
# - fireworks：使用 FIREWORKS_API_KEY + FIREWORKS_BASE_URL
# - moonshot：使用 MOONSHOT_API_KEY + MOONSHOT_BASE_URL
CHAT_PROVIDER=fireworks

# 审卷人供应商（openrouter / fireworks）
REVIEW_PROVIDER=openrouter

# Fireworks AI 配置（当 REVIEW_PROVIDER=fireworks 时使用）
FIREWORKS_API_KEY=your_fireworks_key_here
FIREWORKS_BASE_URL=https://api.fireworks.ai/inference/v1

# 模型配置
# 主AI模型（用于对话和工具调用编排）
MAIN_MODEL=accounts/fireworks/models/deepseek-v3p2
# 子AI模型（用于题目选择）
SUB_MODEL=accounts/fireworks/models/deepseek-v3p2

# 模型参数配置
# 主AI参数
# Moonshot kimi-* 模型可能要求 temperature=1（代码会自动兜底修正）
MAIN_MODEL_TEMPERATURE=0.7
MAIN_MODEL_MAX_TOKENS=2000

# 子AI参数
SUB_MODEL_TEMPERATURE=0.3
SUB_MODEL_MAX_TOKENS=1000

# 对话配置
MAX_TOOL_ITERATIONS=10

# ======================
# Agent Runtime（Codex runtime）
# ======================
# 中/重型 agent 任务默认走本机 Codex runtime，而不是旧 AgentCore/AgentRuntime。
AGENT_RUNTIME=codex_runtime
CODEX_RUNTIME_COMMAND=codex
CODEX_RUNTIME_MODEL=
CODEX_RUNTIME_EFFORT=high
CODEX_RUNTIME_APPROVAL_POLICY=never
CODEX_RUNTIME_SANDBOX=workspace-write
# 可选：显式指定 Codex CLI 代理；留空时 Windows 会自动继承当前用户的系统代理。
CODEX_RUNTIME_PROXY=
CODEX_RUNTIME_TIMEOUT_S=900
# 默认不静默回退旧 agent；如需临时回滚可设为 1。
CODEX_RUNTIME_FALLBACK_LEGACY=0

# 爬虫配置
DEFAULT_SUBJECT=高中数学
# 难度过滤模式（multi 默认，多档；single 严格单档）
DIFFICULTY_QUERY_MODE=multi

# 超时配置（秒）
API_TIMEOUT=120
SUB_AI_TIMEOUT=60

# ======================
# LLM 控制台日志（调试）
# ======================
# 是否在后端控制台打印所有 LLM 调用信息（默认 1）
LLM_CONSOLE_LOG=1
# 是否打印流式 delta（默认 1）
LLM_CONSOLE_STREAM=1
# 单条 delta 最大字符（默认 3000）
# LLM_CONSOLE_DELTA_MAX_CHARS=3000
# 是否同时打印 base_url（默认 0）
# LLM_CONSOLE_LOG_URL=0

# Reviewer (OpenRouter) - for MCP tool review_paper
REVIEW_MODEL=openai/gpt-4o-mini
REVIEW_MODEL_TEMPERATURE=0.2
REVIEW_MODEL_MAX_TOKENS=1800
REVIEW_TIMEOUT=90
REVIEW_MAX_STEM_CHARS=900
REVIEW_HTTP_REFERER=http://localhost:8000
REVIEW_X_TITLE=Study AI - Reviewer

# Zhipu BigModel (for MCP tool: web_search)
ZHIPU_API_KEY=your_zhipu_api_key_here
ZHIPU_BASE_URL=https://open.bigmodel.cn/api/paas/v4
ZHIPU_MODEL=glm-4.5
ZHIPU_TIMEOUT=60

# Exa AI Search（用于自学资料：web_search_knowledge / deepresearch）
EXA_API_KEY=
EXA_BASE_URL=https://api.exa.ai

# Tavily AI Search（默认搜索供应商；用于 web_search_knowledge / deepresearch）
TAVILY_API_KEY=
TAVILY_BASE_URL=https://api.tavily.com
TAVILY_TIMEOUT=60

# Metaso AI Search（用于自学资料：web_search_knowledge）
# - 官方 API base_url 默认：https://metaso.cn/api/v1
METASO_API_KEY=
METASO_BASE_URL=https://metaso.cn/api/v1
METASO_TIMEOUT=30

# Metaso /ask（直接问答，返回 answer + sources）
# - study-materials 默认已切到 ask（可用 STUDY_MATERIALS_METASO_MODE=search 回退到 /search）
STUDY_MATERIALS_METASO_MODE=ask
# /ask 的输出格式（目前 simple/direct/markdown/text/raw 都可用；默认 simple）
METASO_ASK_FORMAT=simple
# 可选：指定 Metaso 侧模型（留空用默认）
METASO_ASK_MODEL=

# 当主写作模型未配置/不可用时：是否用 Metaso /ask 作为“写作兜底”（仍需 METASO_API_KEY；若 STUDY_MATERIALS_DISABLE_METASO=1 则忽略）
STUDY_MATERIALS_METASO_WRITER_FALLBACK=1

# Zhihu（可选）：用于抓取需要登录态的知乎文章/回答（DeepResearch 会自动使用）
# 提示：复制浏览器请求头里的 Cookie 字符串即可；不要提交到 Git。
ZHIHU_COOKIES=

# ======================
# Web UI 登录（JWT）
# ======================
# 说明：
# - Web UI 的「对话」功能需要登录后才能使用
# - 登录成功后前端会把 token 持久化在浏览器 localStorage（默认 key: auth-storage）
#
# 建议：开发/本地环境可以先用默认值；生产环境务必修改 JWT_SECRET 与管理员密码。

# JWT 密钥（必填；生产环境请修改为随机长字符串）
# 注意：后端不会再把 JWT_SECRET 写入磁盘文件（例如 .local/jwt_secret.txt），必须通过环境变量/.env 注入。
JWT_SECRET=dev-jwt-secret-change-me

# Token 过期时间（小时）
JWT_EXPIRE_HOURS=24

# 默认管理员账号（用于后台内置用户：无需数据库）
ADMIN_USERNAME=admin
# 管理员密码（必填；不要使用弱口令。）
ADMIN_PASSWORD=dev-admin-change-me
ADMIN_ROLE=admin

# ======================
# 自学资料（study-materials）
# ======================
# 是否启用百科/网页正文/StackExchange/GitHub 等额外检索工具
STUDY_MATERIALS_ENABLE_EXTRA_TOOLS=0

# 是否启用题库（例题/练习题）。默认关闭，先专注概念与理解。
STUDY_MATERIALS_ENABLE_QUESTIONS=0

# 默认生成预设（可选）：quick | standard | deep | research
# - standard：平衡（默认）
# - deep：更深入（多源 + 更长讲解）
# - research：研究型（多轮检索 + 更严格的条件/反例/推导覆盖，可能更慢）
# STUDY_MATERIALS_PRESET=standard

# foreach_knowledge_point 子代理并发（提升生成速度，但并发过高可能触发限流）
STUDY_MATERIALS_SUBAGENT_CONCURRENCY=3

# 子代理检索策略：默认走 Tavily 搜索（deep/research preset 默认 deepresearch 多轮），可选“思考拆分”提高覆盖面
# - 强制切换：STUDY_MATERIALS_SEARCH_MODE=tavily | exa | deepresearch | metaso（显式设置时不会回退）
# - 是否拆分：默认开启（对 Tavily/Exa 搜索、Metaso /ask 都生效）
STUDY_MATERIALS_WEB_DECOMPOSE=1
# - 每个知识点拆成几个子问题（2-6，默认 4）
STUDY_MATERIALS_WEB_SUBQUERIES=4
# - 搜索模式（留空表示：deep/research preset 默认 deepresearch，否则默认 tavily）
# STUDY_MATERIALS_SEARCH_MODE=
# - 禁用 Metaso（即使配置了 METASO_API_KEY 也不使用）
# STUDY_MATERIALS_DISABLE_METASO=0
# - 每个知识点最多保留多少条来源链接（3-40；默认跟随 limit）
# STUDY_MATERIALS_WEB_KEEP_SOURCES=12
# - Exa：每条 query 取多少条结果（1-10；默认 min(5, limit)）
# STUDY_MATERIALS_EXA_PER_QUERY_RESULTS=5
# - 子问题并发（Exa / Metaso 同时请求时的并发；默认 2）
# STUDY_MATERIALS_WEB_SUBQUERY_CONCURRENCY=2
# - Metaso /ask：每个子问题保留的 sources 数量（2-10；默认 min(5, limit)）
# STUDY_MATERIALS_WEB_SUBQUERY_SIZE=5
# - deepresearch 参数（覆盖 preset 默认；留空用默认）
# STUDY_MATERIALS_DEEPRESEARCH_BREADTH=
# STUDY_MATERIALS_DEEPRESEARCH_DEPTH=
# STUDY_MATERIALS_DEEPRESEARCH_MAX_QUERIES=
# STUDY_MATERIALS_DEEPRESEARCH_PER_QUERY_RESULTS=
# STUDY_MATERIALS_DEEPRESEARCH_CONCURRENCY=
# STUDY_MATERIALS_DEEPRESEARCH_LEARNINGS_PER_QUERY=

# 子代理“思考/拆分”模型（默认使用 SUB_MODEL；可单独指定）
STUDY_MATERIALS_THINKING_MODEL=accounts/fireworks/models/deepseek-v3p2
# 子代理“写作/讲解”模型（默认使用 SUB_MODEL；可单独指定更强模型）
STUDY_MATERIALS_WRITER_MODEL=accounts/fireworks/models/deepseek-v3p2

# OpenRouter：可选 reasoning/thinking（low/medium/high/xhigh），exclude=1 表示不返回 reasoning
# STUDY_MATERIALS_THINKING_MODE=1
# STUDY_MATERIALS_THINKING_EFFORT=xhigh
STUDY_MATERIALS_REASONING_EXCLUDE=0

# 单个工具步骤超时（秒）：避免偶发卡住无响应
STUDY_MATERIALS_STEP_TIMEOUT_S=240

# LaTeX 相关步骤超时（秒）：Markdown→LaTeX / LaTeX 修订 / LaTeX→PDF
# 这类步骤可能包含多次长 LLM 调用（分段+续写）或首次编译较慢（MiKTeX 装包），建议更长。
# STUDY_MATERIALS_LATEX_STEP_TIMEOUT_S=1800

# LaTeX 输出上限（避免输出被 length 截断；数值越大越不容易截断，但会更耗 token）
# STUDY_MATERIALS_LATEX_MAX_TOKENS=8000
# STUDY_MATERIALS_LATEX_REFINE_MAX_TOKENS=8000

# 讲解正文输出上限（留空/0 表示“无限”：代码会用很大的 max_tokens 以避免截断）
# STUDY_MATERIALS_WRITER_MAX_TOKENS=0
# 当输出仍被截断时：最多自动续写次数（默认 20，上限 100）
# STUDY_MATERIALS_MAX_CONTINUATIONS=20

# one-shot 提升：当 LLM 审查未通过时，自动执行一次“修订 + 复审”（无需进入下一轮规划）
STUDY_MATERIALS_AUTO_REVISE=1

# 自主性提升：当启发式审查判定“资料来源不足”时，自动对问题知识点追加一轮检索+再生成（一次性补齐）
STUDY_MATERIALS_AUTO_RESEARCH=1
# 最多对多少个“资料不足”的知识点做自动补检索（避免爆炸式调用）
STUDY_MATERIALS_AUTO_RESEARCH_MAX_POINTS=3

# SSE 心跳间隔（秒）：长工具调用期间保持前端有输出，避免“无输出假死”
STUDY_MATERIALS_SSE_HEARTBEAT_S=4

# 任务保留时间（秒）：用于浏览器刷新后续流/恢复
STUDY_MATERIALS_TASK_TTL_S=3600

# 任务池容量（内存）
STUDY_MATERIALS_MAX_TASKS=50
STUDY_MATERIALS_TASK_MAX_EVENTS=8000

# ======================
# LessonPlan（教案）
# ======================
# 子代理并发：教研资料收集阶段的并行度（默认 3，上限 20）
# LESSON_PLAN_SUBAGENT_CONCURRENCY=3
#
# 超长输出的 max_tokens（留空/0 表示“无限”：代码会用很大的 max_tokens）
# 仅影响教案 JSON 生成与 LaTeX 转换/修订等长输出步骤，不影响全局 `LESSON_PLAN_MAX_TOKENS`。
# LESSON_PLAN_INFINITE_MAX_TOKENS=0
#
# 可选：为“教案正文撰写”单独指定模型（默认用 LESSON_PLAN_MODEL / MAIN_MODEL）
# LESSON_PLAN_WRITER_MODEL=

# ======================
# AI 出题（Question Library）
# ======================
# 内存任务池容量（避免无限增长）
QUESTION_LIBRARY_MAX_TASKS=50
# 任务保留时间（秒）：用于刷新续流/恢复查看
QUESTION_LIBRARY_TASK_TTL_S=3600
# 单任务最多保留事件数
QUESTION_LIBRARY_TASK_MAX_EVENTS=8000

# 草稿生成（realize）输出上限（留空表示自动）
# QUESTION_LIBRARY_REALIZE_MAX_TOKENS=6000

# 审题模型（留空表示使用默认 lesson_plan 模型）
# QUESTION_LIBRARY_JUDGE_MODEL=

# MCP 搜索素材阶段使用的模型（用于 CLI: backend.cli.question_generate）
# - 该阶段依赖 tools + 引用 URL，建议使用支持 tool-calling 的模型
# - 默认值：openai/gpt-5-mini（通过 OpenRouter 调用）
# QUESTION_LIBRARY_MCP_SEARCH_MODEL=openai/gpt-5-mini

# 后台自动打分（可选）
# QUESTION_LIBRARY_AUTO_SCORE=0
# QUESTION_LIBRARY_SCORE_INTERVAL_S=20
# QUESTION_LIBRARY_SCORE_BATCH=20
# QUESTION_LIBRARY_HIDE_THRESHOLD=70
# QUESTION_LIBRARY_SCORE_USER_ID=1
# QUESTION_LIBRARY_SCORE_SUBJECT=
# QUESTION_LIBRARY_SCORE_MODEL=

# ======================
# AI 组卷
# ======================
# 蓝图组卷默认由 AGENT_RUNTIME=codex_runtime 接管；AGENT_RUNTIME=legacy 时可用该开关回滚旧 Agentic 编排。
# PAPER_COMPOSE_AGENTIC_BLUEPRINT=0

# ======================
# 试卷导出（Markdown / LaTeX / PDF / DOCX）
# ======================
# LaTeX 引擎（留空会自动探测 xelatex/pdflatex）
# PAPER_EXPORT_LATEX_ENGINE=xelatex
# LaTeX 编译超时（秒，默认 30；可适当调大）
# PAPER_EXPORT_LATEX_TIMEOUT_S=30
# PDF 编译后端：auto | docker | host。auto 会优先使用 Docker 沙盒，镜像不可用时回退宿主机。
# PAPER_EXPORT_LATEX_BACKEND=auto
# Docker LaTeX 沙盒镜像与资源限制（用于 Agentic 组卷和 PDF 导出）
# LATEX_SANDBOX_DOCKER_IMAGE=study-ai/latex-sandbox:latest
# LATEX_SANDBOX_TIMEOUT_S=600
# LATEX_SANDBOX_MEMORY=1g
# LATEX_SANDBOX_CPUS=2
# LATEX_SANDBOX_PIDS_LIMIT=128
# LATEX_SANDBOX_USER=1000:1000
# Agent 工具编译 PDF 的超时（秒，默认 30）
# AGENT_LATEX_COMPILE_TIMEOUT_S=30

# DOCX 导出引擎（优先 pandoc；留空会自动探测）
# PAPER_EXPORT_DOCX_ENGINE=pandoc
# pandoc 导出超时（秒）
PAPER_EXPORT_PANDOC_TIMEOUT_S=60

# ======================
# Canvas 版本历史
# ======================
# 每个画布保留多少个历史版本（默认 30，上限 500）
CANVAS_VERSION_MAX_KEEP=30

# ======================
# OpenTelemetry Tracing（可选）
# ======================
# 是否开启 OpenTelemetry（默认关闭）
# OTEL_ENABLE=0
# 服务名（用于 Jaeger/Tempo 等后端展示）
# OTEL_SERVICE_NAME=study_ai
# OTLP/HTTP 上报地址（示例：本机 collector）
# OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318/v1/traces
# OTLP/HTTP traces 上报地址（与 OTEL_EXPORTER_OTLP_ENDPOINT 互补）
# OTEL_EXPORTER_OTLP_TRACES_ENDPOINT=

# ======================
# 应用环境与日志
# ======================
# 运行环境标识（development / production 等；影响 auth cookie secure 默认值）
# APP_ENV=
# 通用 ENV 别名（部分模块读取）
# ENV=
# 日志格式（json / 空字符串=人类可读）
# LOG_FORMAT=
# 日志级别（DEBUG / INFO / WARNING / ERROR）
# LOG_LEVEL=
# 是否在 LLM 控制台日志中打印元数据（默认 0）
# LLM_CONSOLE_META=0

# ======================
# CORS / 反向代理
# ======================
# 允许的跨域来源（逗号分隔；生产环境务必收紧）
CORS_ORIGINS=http://localhost:3000,http://localhost:5173
# 受信任的反向代理 IP/CIDR 列表（逗号分隔；启用 TRUST_PROXY_HEADERS 时才生效）
# TRUSTED_PROXIES=
# 是否信任代理头（X-Forwarded-For / Forwarded 等；默认 0=不信任）
# TRUST_PROXY_HEADERS=0

# ======================
# 认证与安全
# ======================
# 管理员密码哈希（可选；设置后优先于 ADMIN_PASSWORD 明文）
# ADMIN_PASSWORD_HASH=
# Auth cookie 是否强制 secure（生产环境建议 1）
# AUTH_COOKIE_SECURE=0
# 登录失败限流：窗口内最大失败次数
# AUTH_RATE_LIMIT_MAX_FAILS=10
# 登录失败限流：窗口大小（秒）
# AUTH_RATE_LIMIT_WINDOW_S=600
# 本地加密密钥路径（用于加密敏感数据；留空则不加密）
# LOCAL_ENCRYPTION_KEY_PATH=
# 审计日志是否启用（默认 1）
# AUDIT_LOG_ENABLED=1
# 审计日志文件路径（默认 .local/audit.jsonl）
# AUDIT_LOG_PATH=

# ======================
# API 速率限制
# ======================
# 通用 API 速率限制后端（memory / redis；默认 memory）
# RATE_LIMIT_BACKEND=memory
# 通用 API 速率限制：窗口内最大请求数
# API_RATE_LIMIT_MAX_REQUESTS=
# 通用 API 速率限制：窗口大小（秒）
# API_RATE_LIMIT_WINDOW_S=
# 通用 API 速率限制：最大 key 数（限流桶上限）
# API_RATE_LIMIT_MAX_KEYS=
# 试卷下载链接速率限制：窗口内最大请求
# PAPER_DOWNLOAD_LINK_RATE_LIMIT_MAX=
# 试卷下载链接速率限制：窗口大小（秒）
# PAPER_DOWNLOAD_LINK_RATE_LIMIT_WINDOW_S=
# 试卷下载链接速率限制：最大 key 数
# PAPER_DOWNLOAD_LINK_RATE_LIMIT_MAX_KEYS=
# Canvas 渲染题目速率限制：窗口内最大请求
# CANVAS_RENDER_QUESTION_RATE_LIMIT_MAX=
# Canvas 渲染题目速率限制：窗口大小（秒）
# CANVAS_RENDER_QUESTION_RATE_LIMIT_WINDOW_S=
# Canvas 渲染题目速率限制：最大 key 数
# CANVAS_RENDER_QUESTION_RATE_LIMIT_MAX_KEYS=

# ======================
# 输入校验限制
# ======================
# 请求体最大字节数
# INPUT_MAX_BODY_BYTES=
# 字符串最大长度
# INPUT_MAX_STRING_LENGTH=
# 数组最大元素数
# INPUT_MAX_ARRAY_SIZE=
# 对象最大 key 数
# INPUT_MAX_OBJECT_KEYS=
# 嵌套最大深度
# INPUT_MAX_NESTED_DEPTH=
# 是否剥离 HTML 标签（默认 0）
# INPUT_STRIP_HTML_TAGS=0

# ======================
# 数据库连接池
# ======================
# 连接池大小
# DB_POOL_SIZE=5
# 连接池溢出上限
# DB_MAX_OVERFLOW=10
# 连接池获取超时（秒）
# DB_POOL_TIMEOUT_S=30
# SQLite busy 超时（秒）
# DB_BUSY_TIMEOUT_S=30
# 自定义数据库路径（默认 .local/exam_papers.db）
# STUDY_AI_DB_PATH=
# 任务 JSON 最大字符数（防止超大 payload）
# TASK_JSON_MAX_CHARS=200000

# ======================
# Canvas
# ======================
# Canvas 快照最大字节数
# CANVAS_SNAPSHOT_MAX_BYTES=

# ======================
# Chat 上下文限制
# ======================
# 对话上下文最大消息数
# CHAT_CONTEXT_MAX_MESSAGES=
# 对话上下文最大字符数
# CHAT_CONTEXT_MAX_CHARS=
# 对话上下文最大 token 数
# CHAT_CONTEXT_MAX_TOKENS=
# 单条消息最大字符数
# CHAT_CONTEXT_MESSAGE_MAX_CHARS=
# 单条消息最大 token 数
# CHAT_CONTEXT_MESSAGE_MAX_TOKENS=

# ======================
# LLM 并发与熔断
# ======================
# 全局 LLM 最大并发请求数
# LLM_MAX_CONCURRENT_REQUESTS=
# MAX_CONCURRENT_LLM_REQUESTS 别名
# MAX_CONCURRENT_LLM_REQUESTS=
# 熔断器：连续失败几次后打开
# LLM_CIRCUIT_BREAKER_FAIL_THRESHOLD=6
# 熔断器：打开持续时间（秒）
# LLM_CIRCUIT_BREAKER_OPEN_SECONDS=30
# 是否锁定 provider（不自动切换；默认 0）
# LLM_PROVIDER_PINNED=0

# ======================
# 模型配置与上下文限制
# ======================
# config/model.json 路径（默认 config/model.json）
# MODEL_CONFIG_PATH=
# 模型上下文长度映射（JSON 字符串；留空用内置表）
# MODEL_CONTEXT_LENGTHS=
# 模型上下文输入倍率
# MODEL_CONTEXT_INPUT_MULTIPLIER=
# 模型上下文预留 token 比例
# MODEL_CONTEXT_RESERVE_RATIO=
# 模型上下文预留 token 数
# MODEL_CONTEXT_RESERVE_TOKENS=
# 是否从 OpenRouter 拉取模型上下文限制
# OPENROUTER_FETCH_MODEL_LIMITS=
# OpenRouter 模型列表缓存 TTL（秒）
# OPENROUTER_MODELS_CACHE_TTL_S=
# OpenRouter 模型列表请求超时（秒）
# OPENROUTER_MODELS_TIMEOUT_S=
# 是否启用 tiktoken 分词器
# STUDY_AI_ENABLE_TIKTOKEN=
# 图表输出格式（png / svg）
# STUDY_AI_PLOT_FORMAT=

# ======================
# Agent 通用运行时
# ======================
# Agent 执行模式（plan / react；默认 react）
# AGENT_MODE=react
# Agent 最大迭代次数（plan 模式）
# AGENT_MAX_ITERATIONS=5
# 是否允许并行工具调用
# AGENT_PARALLEL_TOOL_CALLS=true
# ReAct 最大迭代次数
# AGENT_REACT_MAX_ITERATIONS=20
# ReAct LLM 调用预算
# AGENT_REACT_LLM_CALL_BUDGET=25
# ReAct 每个工具重试预算
# AGENT_REACT_RETRY_BUDGET_PER_TOOL=2
# 滑动窗口大小
# AGENT_SLIDING_WINDOW_SIZE=10
# 软压缩 token 阈值
# AGENT_TOKEN_THRESHOLD=32000
# 紧急压缩 token 阈值
# AGENT_EMERGENCY_TOKEN_THRESHOLD=48000
# 压缩历史最大条数
# AGENT_COMPRESSED_HISTORY_MAX=5
# 压缩超时（秒）
# AGENT_COMPRESS_TIMEOUT_S=
# 检查点目录
# AGENT_CHECKPOINT_DIR=data/checkpoints
# Agent 单步超时（秒）
# AGENT_STEP_TIMEOUT_S=
# Agent profiling 超时（秒）
# AGENT_PROFILE_TIMEOUT_S=
# Agent LLM 重试次数
# AGENT_LLM_RETRIES=
# 是否流式输出推理过程
# AGENT_STREAM_REASONING=
# 子代理并发数
# AGENT_SUBAGENT_CONCURRENCY=
# Planner 模型
# AGENT_PLANNER_MODEL=
# Planner 超时（秒）
# AGENT_PLANNER_TIMEOUT_S=
# Summarizer 模型
# AGENT_SUMMARIZER_MODEL=
# Reflector 模型
# AGENT_REFLECTOR_MODEL=
# 语义搜索超时（秒）
# AGENT_SEMANTIC_SEARCH_TIMEOUT_S=
# 语义存储后端（chromadb / jsonl）
# AGENT_SEMANTIC_STORE=
# 语义 upsert 超时（秒）
# AGENT_SEMANTIC_UPSERT_TIMEOUT_S=
# Codex runtime 是否允许 danger full-access（默认 0）
# CODEX_RUNTIME_ALLOW_DANGER_FULL_ACCESS=0

# ======================
# DeepThink / Tree-of-Thoughts
# ======================
# 生成器模型
# DEEPTHINK_GENERATOR_MODEL=
# 生成器温度
# DEEPTHINK_GENERATOR_TEMPERATURE=0.4
# 生成器最大 token
# DEEPTHINK_GENERATOR_MAX_TOKENS=1400
# 评估器模型
# DEEPTHINK_EVALUATOR_MODEL=
# 评估器温度
# DEEPTHINK_EVALUATOR_TEMPERATURE=0.2
# 评估器最大 token
# DEEPTHINK_EVALUATOR_MAX_TOKENS=900
# 推理强度（low / medium / high / xhigh）
# DEEPTHINK_REASONING_EFFORT=high
# ToT 分支因子
# TOT_BRANCH_FACTOR=3
# ToT 束宽
# TOT_BEAM_WIDTH=3
# ToT 最大深度
# TOT_MAX_DEPTH=4
# ToT 剪枝阈值
# TOT_PRUNE_THRESHOLD=5.0
# ToT 超时（秒）
# TOT_TIMEOUT=60

# ======================
# 教案（Lesson Plan）扩展
# ======================
# 教案 provider（openrouter / fireworks / moonshot）
# LESSON_PLAN_PROVIDER=
# 教案模型
# LESSON_PLAN_MODEL=
# 教案温度
# LESSON_PLAN_TEMPERATURE=0.7
# 教案最大 token
# LESSON_PLAN_MAX_TOKENS=50000
# 教案 LLM 重试次数
# LESSON_PLAN_LLM_RETRIES=
# 教案 Planner 超时（秒）
# LESSON_PLAN_PLANNER_TIMEOUT_S=
# 知识点审查模型
# LESSON_PLAN_KP_REVIEW_MODEL=
# 研究模型
# LESSON_PLAN_RESEARCH_MODEL=
# 拆分模型
# LESSON_PLAN_SPLIT_MODEL=
# LaTeX 生成模型
# LESSON_PLAN_LATEX_MODEL=
# LaTeX 修订模型
# LESSON_PLAN_LATEX_REFINE_MODEL=
# LaTeX 步骤超时（秒）
# LESSON_PLAN_LATEX_TIMEOUT_S=

# ======================
# 自学资料（Study Materials）扩展
# ======================
# 大纲模型
# STUDY_MATERIALS_OUTLINE_MODEL=
# 知识点拆分模型
# STUDY_MATERIALS_KP_SPLIT_MODEL=
# 知识点拆分超时（秒）
# STUDY_MATERIALS_KP_SPLIT_TIMEOUT_S=
# 知识点审查模型
# STUDY_MATERIALS_KP_REVIEW_MODEL=
# 知识点审查超时（秒）
# STUDY_MATERIALS_KP_REVIEW_TIMEOUT_S=
# 预规划超时（秒）
# STUDY_MATERIALS_PREPLAN_TIMEOUT_S=
# Planner 超时（秒）
# STUDY_MATERIALS_PLANNER_TIMEOUT_S=
# Profiling 超时（秒）
# STUDY_MATERIALS_PROFILE_TIMEOUT_S=
# 写作代理修订轮数
# STUDY_MATERIALS_WRITER_AGENT_REVISION_ROUNDS=
# LLM 重试次数
# STUDY_MATERIALS_LLM_RETRIES=
# 是否严格 LLM 校验
# STUDY_MATERIALS_STRICT_LLM=
# 推理模式
# STUDY_MATERIALS_REASONING=
# 推理强度
# STUDY_MATERIALS_REASONING_EFFORT=
# 流式推理
# STUDY_MATERIALS_STREAM_REASONING=
# 推理事件最大字符
# STUDY_MATERIALS_REASONING_EVENT_MAX_CHARS=
# 推理事件发射间隔（秒）
# STUDY_MATERIALS_REASONING_EMIT_INTERVAL_S=
# 推理事件单次发射字符数
# STUDY_MATERIALS_REASONING_EMIT_CHARS=
# 章节并发
# STUDY_MATERIALS_SECTION_CONCURRENCY=
# 压缩超时（秒）
# STUDY_MATERIALS_COMPRESS_TIMEOUT_S=
# 类型检测模型
# STUDY_MATERIALS_TYPE_MODEL=
# 合成模型
# STUDY_MATERIALS_SYNTHESIS_MODEL=
# 审稿模型
# STUDY_MATERIALS_CRITIQUE_MODEL=
# 审稿阈值
# STUDY_MATERIALS_CRITIQUE_THRESHOLD=
# 审稿跳过阈值
# STUDY_MATERIALS_CRITIQUE_SKIP_THRESHOLD=
# 修订模型
# STUDY_MATERIALS_REFINER_MODEL=
# 修订阈值
# STUDY_MATERIALS_REFINE_THRESHOLD=
# 可信度过滤最小值
# STUDY_MATERIALS_CREDIBILITY_FILTER_MIN=
# 网页浏览缓存最大条数
# STUDY_MATERIALS_BROWSE_CACHE_MAX_ENTRIES=
# 网页浏览缓存 TTL（秒）
# STUDY_MATERIALS_BROWSE_CACHE_TTL_S=
# 网页浏览内联最小字符数
# STUDY_MATERIALS_BROWSE_INLINE_MIN_CHARS=
# 网页搜索缓存最大条数
# STUDY_MATERIALS_WEB_SEARCH_CACHE_MAX_ENTRIES=
# 网页搜索缓存 TTL（秒）
# STUDY_MATERIALS_WEB_SEARCH_CACHE_TTL_S=
# LaTeX 模型
# STUDY_MATERIALS_LATEX_MODEL=
# LaTeX 是否总是修订
# STUDY_MATERIALS_LATEX_ALWAYS_REFINE=
# LaTeX 修订模型
# STUDY_MATERIALS_LATEX_REFINE_MODEL=
# LaTeX 最大续写次数
# STUDY_MATERIALS_LATEX_MAX_CONTINUATIONS=
# LaTeX 修订最大续写次数
# STUDY_MATERIALS_LATEX_REFINE_MAX_CONTINUATIONS=
# LaTeX 分段并发
# STUDY_MATERIALS_LATEX_PART_CONCURRENCY=
# LaTeX 超时（秒）
# STUDY_MATERIALS_LATEX_TIMEOUT=
# LaTeX 超时（秒，别名）
# STUDY_MATERIALS_LATEX_TIMEOUT_S=
# TikZ 超时（秒）
# STUDY_MATERIALS_TIKZ_TIMEOUT_S=
# Asy 超时（秒）
# STUDY_MATERIALS_ASY_TIMEOUT_S=
# 图表规划模型
# STUDY_MATERIALS_DIAGRAM_PLANNER_MODEL=

# ======================
# AI 组卷（Paper Compose）扩展
# ======================
# 试卷分析模型
# PAPER_ANALYSIS_MODEL=
# 是否启用全量 agentic 组卷
# PAPER_COMPOSE_AGENTIC_FULL=
# 是否启用 AI 答案合成
# PAPER_COMPOSE_AI_ANSWER_SYNTHESIS=
# 是否自动审卷
# PAPER_COMPOSE_AUTO_REVIEW=
# 余额修正
# PAPER_COMPOSE_BALANCE_CORRECTION=
# 详情并发
# PAPER_COMPOSE_DETAILS_CONCURRENCY=
# 是否抓取详情
# PAPER_COMPOSE_FETCH_DETAILS=
# 是否 LLM 审卷
# PAPER_COMPOSE_LLM_REVIEW=
# 最大答案合成条目
# PAPER_COMPOSE_MAX_ANSWER_SYNTHESIS_ITEMS=
# 最大数值校验条目
# PAPER_COMPOSE_MAX_NUMERIC_VERIFICATION_ITEMS=
# 数值校验
# PAPER_COMPOSE_NUMERIC_VERIFICATION=
# 是否要求人工审卷
# PAPER_COMPOSE_REQUIRE_HUMAN_REVIEW=
# 审卷题干最大字符
# PAPER_COMPOSE_REVIEW_MAX_STEM_CHARS=
# 审卷模型
# PAPER_COMPOSE_REVIEW_MODEL=
# 审卷超时（秒）
# PAPER_COMPOSE_REVIEW_TIMEOUT_S=
# 槽位并发
# PAPER_COMPOSE_SLOT_CONCURRENCY=
# SSE 心跳（秒）
# PAPER_COMPOSE_SSE_HEARTBEAT_S=

# ======================
# AI 出题（Question Library）扩展
# ======================
# 是否校验图表
# QUESTION_LIBRARY_DIAGRAM_VERIFY=
# 图表校验严格度
# QUESTION_LIBRARY_DIAGRAM_VERIFY_STRICTNESS=
# SSE 心跳（秒）
# QUESTION_LIBRARY_SSE_HEARTBEAT_S=

# ======================
# 知识视频
# ======================
# 知识视频模型
# KNOWLEDGE_VIDEO_MODEL=
# 渲染质量
# KNOWLEDGE_VIDEO_QUALITY=low
# Docker 镜像
# KNOWLEDGE_VIDEO_DOCKER_IMAGE=study-ai/manim-sandbox:latest
# 渲染超时（秒）
# KNOWLEDGE_VIDEO_RENDER_TIMEOUT_S=180
# Docker CPU 限制
# KNOWLEDGE_VIDEO_DOCKER_CPUS=2
# Docker 内存限制
# KNOWLEDGE_VIDEO_DOCKER_MEMORY=1g
# Docker 进程数限制
# KNOWLEDGE_VIDEO_DOCKER_PIDS_LIMIT=128
# Docker user
# KNOWLEDGE_VIDEO_DOCKER_USER=1000:1000
# LLM 输出上限、温度与请求超时
# KNOWLEDGE_VIDEO_MAX_TOKENS=8000
# KNOWLEDGE_VIDEO_TEMPERATURE=0.3
# KNOWLEDGE_VIDEO_LLM_TIMEOUT_S=180
# Docker 二进制路径（自动探测）
# DOCKER_BIN=

# ======================
# Docker 组卷沙盒
# ======================
# 沙盒根目录
# COMPOSE_SANDBOX_ROOT=
# 沙盒 Docker 镜像
# COMPOSE_SANDBOX_DOCKER_IMAGE=
# 沙盒 CPU 限制
# COMPOSE_SANDBOX_CPUS=
# 沙盒内存限制
# COMPOSE_SANDBOX_MEMORY=
# 沙盒 user
# COMPOSE_SANDBOX_USER=

# ======================
# 图表缓存
# ======================
# 图表缓存最大条数
# DIAGRAM_CACHE_MAX_ENTRIES=

# ======================
# 导出
# ======================
# 导出 ZIP 最大文件数
# EXPORT_ZIP_MAX_FILES=

# ======================
# 反馈与 Webhook
# ======================
# 反馈 Webhook URL
# FEEDBACK_WEBHOOK_URL=

# ======================
# 图片生成（Ark / Seedream）
# ======================
# Ark API 端点
# ARK_API=
# Ark API Key
# ARK_API_KEY=
# Ark Base URL
# ARK_BASE_URL=
# Ark 文生图模型
# ARK_IMAGE_MODEL=
# Ark Images 模型
# ARK_IMAGES_MODEL=
# Ark Images 输出格式
# ARK_IMAGES_RESPONSE_FORMAT=
# Ark Images 尺寸
# ARK_IMAGES_SIZE=
# Ark Images 超时（秒）
# ARK_IMAGES_TIMEOUT_S=
# Seedream 模型
# SEEDREAM_MODEL=
# Seedream n
# SEEDREAM_N=
# Seedream 响应格式
# SEEDREAM_RESPONSE_FORMAT=
# Seedream 尺寸
# SEEDREAM_SIZE=
# Seedream 超时（秒）
# SEEDREAM_TIMEOUT_S=

# ======================
# 媒体代理
# ======================
# 允许的媒体代理域名（逗号分隔）
# MEDIA_PROXY_ALLOWED_DOMAINS=
# 媒体代理最大字节数
# MEDIA_PROXY_MAX_BYTES=

# ======================
# MCP 搜索
# ======================
# MCP 搜索超时（秒）
# MCP_SEARCH_TIMEOUT_S=
# MCP 搜索 User-Agent
# MCP_SEARCH_USER_AGENT=
# StackExchange API Base URL
# STACKEXCHANGE_API_BASE_URL=
# StackExchange API Key
# STACKEXCHANGE_KEY=
# GitHub API Base URL
# GITHUB_API_BASE_URL=
# GitHub Token
# GITHUB_TOKEN=

# ======================
# 题源爬虫（Zujuan/Zujian）
# ======================
# 组卷网用户名
# ZUJUAN_USERNAME=
# 组卷网密码
# ZUJUAN_PASSWORD=
# 组卷网 Cookies
# ZUJUAN_COOKIES=
# Netscape/curl 格式的访客 Cookie 文件，用于题库搜索/抓取遇到 JS 挑战页时恢复
# 不替代导出题篮所需的登录脚本；文件缺失、空文件、全量过期会直接报配置错误
# 相对路径从仓库根目录解析
# ZUJUAN_COOKIE_FILE=.local/zujuan_cookies.txt
# 兼容旧拼写别名
# ZUJIAN_COOKIE_FILE=.local/zujuan_cookies.txt
# 组卷网 CSRF Token
# ZUJUAN_CSRF_TOKEN=
# 组卷网 User ID
# ZUJUAN_USER_ID=
# 组卷网 user data 目录
# ZUJUAN_USER_DATA_DIR=
# 是否自动刷新登录态
# ZUJUAN_AUTO_REFRESH_LOGIN=
# 批量详情延迟（秒）
# ZUJUAN_BATCH_GET_DETAILS_DELAY_S=
# 批量详情并发
# ZUJUAN_BATCH_GET_DETAILS_LIMIT=
# 批量详情上限
# ZUJUAN_BATCH_GET_DETAILS_MAX=
# 最大题目详情数
# ZUJUAN_MAX_QUESTION_DETAILS=
# 蓝图槽位并发
# ZUJUAN_BLUEPRINT_SLOT_CONCURRENCY=
# 蓝图槽位延迟（秒）
# ZUJUAN_BLUEPRINT_SLOT_DELAY_S=
# 蓝图槽位重试
# ZUJUAN_BLUEPRINT_SLOT_RETRIES=
# 速率限制突发
# ZUJUAN_RATE_LIMIT_BURST=
# 速率限制 RPS
# ZUJUAN_RATE_LIMIT_RPS=
# ZUJIAN 别名：速率限制突发
# ZUJIAN_RATE_LIMIT_BURST=
# ZUJIAN 别名：速率限制 RPS
# ZUJIAN_RATE_LIMIT_RPS=
# 缓存最大条数
# ZUJIAN_CACHE_MAX_ENTRIES=
# 公式缓存最大条数
# ZUJIAN_FORMULA_CACHE_MAX_ENTRIES=
# 公式缓存 TTL（秒）
# ZUJIAN_FORMULA_CACHE_TTL_S=
# 已用题目范围（控制不同试卷间题目去重）
# USED_QUESTIONS_SCOPE=
# 学科筛选缓存 TTL（秒）
# SUBJECT_FILTERS_CACHE_TTL_S=

# ======================
# 学习归档（Study Archives）
# ======================
# 归档目录（默认 study_archives/）
# STUDY_ARCHIVES_DIR=
# 是否优先本地归档
# STUDY_ARCHIVE_PREFER_LOCAL=
# 归档版本上限
# STUDY_ARCHIVE_VERSION_LIMIT=

# ======================
# Record / Replay（LLM 调试）
# ======================
# 是否录制 LLM 请求
# RECORD=
# 是否回放 LLM 请求
# REPLAY=
# 录制/回放模式
# RECORD_REPLAY_MODE=
# 录制/回放目录
# RECORD_REPLAY_DIR=

# ======================
# Prometheus 指标
# ======================
# 是否启用 Prometheus /metrics（默认 1）
# PROMETHEUS_METRICS_ENABLED=1
