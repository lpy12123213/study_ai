{
  "id": "tcp_congestion_control",
  "title": "TCP 拥塞控制",
  "query": "自学 TCP 拥塞控制：慢启动、拥塞避免、快重传/快恢复的工作原理与状态机，Tahoe/Reno/CUBIC 的演进，以及拥塞控制与流量控制的区别",
  "subject": "计算机网络",
  "preset": "standard",
  "options": {"with_questions": false, "with_diagrams": true, "max_points": 7, "prefer_local_archive": false},
  "expected_knowledge_points": [
    "慢启动",
    "拥塞避免",
    "快重传与快恢复",
    "ssthresh 与 cwnd",
    "Tahoe 与 Reno",
    "CUBIC",
    "拥塞控制与流量控制的区别"
  ],
  "min_unique_sources": 8,
  "expected_domains": ["rfc-editor.org", "datatracker.ietf.org", "wikipedia.org"],
  "required_facts": [
    {
      "id": "slow_start",
      "description": "慢启动：cwnd 每 RTT 近似翻倍（指数增长）",
      "match": {"all": ["慢启动|慢开始|slow ?start"], "any": ["指数", "翻倍", "每(个|一) ?RTT"]},
      "source_urls": ["https://www.rfc-editor.org/rfc/rfc5681"]
    },
    {
      "id": "congestion_avoidance",
      "description": "拥塞避免阶段 cwnd 每 RTT 约增加 1 个 MSS（线性增长）",
      "match": {"all": ["拥塞避免"], "any": ["线性", "加性", "MSS"]},
      "source_urls": ["https://www.rfc-editor.org/rfc/rfc5681"]
    },
    {
      "id": "aimd",
      "description": "AIMD：加性增窗、乘性减窗（拥塞时 cwnd 减半）",
      "match": {"any": ["AIMD", "加性增.{0,6}乘性减", "和式增.{0,6}积式减", "加增乘减"]},
      "source_urls": ["https://en.wikipedia.org/wiki/Additive_increase/multiplicative_decrease"]
    },
    {
      "id": "ssthresh",
      "description": "ssthresh：慢启动阈值，丢包时通常设为丢包时 cwnd 的一半",
      "match": {"all": ["ssthresh|慢启动阈值"], "any": ["一半|减半|1/2", "cwnd|拥塞窗口"]},
      "source_urls": ["https://www.rfc-editor.org/rfc/rfc5681"]
    },
    {
      "id": "fast_retransmit",
      "description": "快重传：收到 3 个重复 ACK 时立即重传，不必等超时",
      "match": {"all": ["快重传|快速重传|fast ?retransmit"], "any": ["重复 ?ACK|冗余 ?ACK", "3 ?个|三(个|次)"]},
      "source_urls": ["https://www.rfc-editor.org/rfc/rfc5681"]
    },
    {
      "id": "fast_recovery",
      "description": "快恢复（Reno）：重传后进入拥塞避免而非回到慢启动",
      "match": {"all": ["快恢复|快速恢复|fast ?recovery"], "any": ["Reno|里诺", "拥塞避免", "不必.{0,8}慢启动"]},
      "source_urls": ["https://www.rfc-editor.org/rfc/rfc6582"]
    },
    {
      "id": "tahoe_vs_reno",
      "description": "Tahoe 与 Reno 的差异：Reno 引入快恢复，Tahoe 丢包后回慢启动",
      "match": {"all": ["Tahoe|塔霍"], "any": ["Reno|里诺"]},
      "source_urls": ["https://en.wikipedia.org/wiki/TCP_congestion_control"]
    },
    {
      "id": "cubic",
      "description": "CUBIC：基于三次函数的拥塞窗口增长，Linux 默认（RFC 8312）",
      "match": {"all": ["CUBIC|Cubic"], "any": ["三次|立方", "Linux", "RFC ?8312"]},
      "source_urls": ["https://www.rfc-editor.org/rfc/rfc8312"]
    },
    {
      "id": "rwnd_vs_cwnd",
      "description": "发送窗口 = min(cwnd, rwnd)：拥塞窗口由发送方估计，接收窗口由接收方通告",
      "match": {"any": ["min\\(.{0,20}(cwnd|拥塞窗口)", "(cwnd|拥塞窗口).{0,30}(rwnd|接收窗口|通告窗口)", "(rwnd|接收窗口|通告窗口).{0,30}(cwnd|拥塞窗口)"]},
      "source_urls": ["https://en.wikipedia.org/wiki/TCP_congestion_control"]
    },
    {
      "id": "rfc_reference",
      "description": "引用权威协议文献（RFC 5681/6582/8312 或等价标准文档）",
      "match": {"any": ["RFC ?5681", "RFC ?6582", "RFC ?8312", "RFC ?793"]},
      "source_urls": ["https://www.rfc-editor.org/rfc/rfc5681"]
    }
  ],
  "traps": [
    {
      "id": "rwnd_is_cwnd",
      "description": "误解：拥塞窗口由接收方通告决定（混淆 rwnd 与 cwnd）",
      "wrong_pattern": "拥塞窗口.{0,12}(由|取决于|是).{0,10}接收方.{0,6}(通告|决定|指定)",
      "correct_pattern": "发送方|网络拥塞|min\\("
    },
    {
      "id": "slow_start_slow",
      "description": "误解：慢启动阶段窗口增长缓慢（实为指数增长）",
      "wrong_pattern": "慢启动.{0,10}(线性|缓慢|较慢).{0,4}增长",
      "correct_pattern": "指数|翻倍"
    },
    {
      "id": "loss_only_timeout",
      "description": "误解：只能靠超时检测丢包",
      "wrong_pattern": "(只有|仅|只能).{0,6}超时.{0,8}(才|能)?.{0,4}(检测|发现|判断).{0,4}丢包|丢包.{0,6}(只能|只有).{0,4}超时",
      "correct_pattern": "重复 ?ACK|冗余 ?ACK|快重传"
    }
  ],
  "contrasts": [
    ["Tahoe", "Reno"],
    ["拥塞控制", "流量控制"]
  ],
  "format_requirements": {
    "key_formulas": ["cwnd|拥塞窗口", "ssthresh|阈值", "RTT"],
    "min_figures": 1,
    "min_tables": 1,
    "min_chars": 6000
  }
}
