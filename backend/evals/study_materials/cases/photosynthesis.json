{
  "id": "photosynthesis",
  "title": "光合作用的机制",
  "query": "自学光合作用：光反应与卡尔文循环的场所与产物、水的光解、ATP 与 NADPH 的作用、C3/C4/CAM 途径差异与光呼吸",
  "subject": "生物学",
  "preset": "standard",
  "options": {"with_questions": false, "with_diagrams": true, "max_points": 7, "prefer_local_archive": false},
  "expected_knowledge_points": [
    "光反应",
    "卡尔文循环",
    "水的光解",
    "ATP 与 NADPH",
    "C3/C4/CAM 途径",
    "光呼吸"
  ],
  "min_unique_sources": 8,
  "expected_domains": ["wikipedia.org", "britannica.com", "ncbi.nlm.nih.gov", "khanacademy.org"],
  "required_facts": [
    {
      "id": "overall_equation",
      "description": "总反应式：6CO₂ + 6H₂O → C₆H₁₂O₆ + 6O₂（光能驱动）",
      "match": {"any": ["6CO|CO2.{0,20}H2O|二氧化碳.{0,20}水.{0,20}葡萄糖", "总反应"]},
      "source_urls": ["https://zh.wikipedia.org/wiki/光合作用"]
    },
    {
      "id": "oxygen_from_water",
      "description": "释放的 O₂ 来自水的光解，而非 CO₂",
      "match": {"all": ["O2|O₂|氧气|氧"], "any": ["来自.{0,4}水|水的光解|光解水|H2O"]},
      "source_urls": ["https://zh.wikipedia.org/wiki/光合作用"]
    },
    {
      "id": "light_reaction_site",
      "description": "光反应发生在类囊体膜（基粒/类囊体），产物 ATP 与 NADPH",
      "match": {"all": ["类囊体|基粒"], "any": ["ATP", "NADPH"]},
      "source_urls": ["https://zh.wikipedia.org/wiki/光反应"]
    },
    {
      "id": "calvin_cycle_site",
      "description": "卡尔文循环在叶绿体基质中进行，RuBisCO 固定 CO₂",
      "match": {"all": ["卡尔文"], "any": ["基质", "RuBisCO|核酮糖二磷酸羧化酶|1,5-二磷酸核酮糖"]},
      "source_urls": ["https://zh.wikipedia.org/wiki/卡尔文循环"]
    },
    {
      "id": "atp_nadph_role",
      "description": "光反应产生的 ATP 与 NADPH 为卡尔文循环供能/供还原力（间接需要光）",
      "match": {"all": ["ATP", "NADPH"], "any": ["供能|能量", "还原力|还原剂"]},
      "source_urls": ["https://zh.wikipedia.org/wiki/卡尔文循环"]
    },
    {
      "id": "c4_cam",
      "description": "C4（先固定为四碳酸，如玉米/甘蔗）与 CAM（夜间固定 CO₂，如景天科）是对高温干旱的适应",
      "match": {"all": ["C4"], "any": ["CAM", "玉米|甘蔗|景天"]},
      "source_urls": ["https://zh.wikipedia.org/wiki/C4光合作用"]
    },
    {
      "id": "photorespiration",
      "description": "光呼吸：RuBisCO 加氧酶活性导致，降低光合效率，C4/CAM 是其规避策略",
      "match": {"all": ["光呼吸"], "any": ["加氧", "RuBisCO", "效率|浪费"]},
      "source_urls": ["https://zh.wikipedia.org/wiki/光呼吸"]
    }
  ],
  "traps": [
    {
      "id": "oxygen_from_co2",
      "description": "误解：光合作用释放的氧气来自二氧化碳",
      "wrong_pattern": "(氧气|O2|O₂).{0,6}来自.{0,4}(二氧化碳|CO2|CO₂)",
      "correct_pattern": "来自.{0,4}水|光解|H2O"
    },
    {
      "id": "dark_reaction_no_light",
      "description": "误解：卡尔文循环（暗反应）完全不需要光",
      "wrong_pattern": "(暗反应|卡尔文循环).{0,8}(完全|根本)?不需要.{0,2}光",
      "correct_pattern": "ATP|NADPH|间接"
    },
    {
      "id": "chlorophyll_absorbs_green",
      "description": "误解：叶绿素主要吸收绿光（实为反射绿光）",
      "wrong_pattern": "叶绿素.{0,6}(主要)?吸收.{0,2}绿光",
      "correct_pattern": "反射|红|蓝紫"
    }
  ],
  "contrasts": [
    ["光反应", "卡尔文循环"],
    ["C3", "C4"]
  ],
  "format_requirements": {
    "key_formulas": ["ATP", "NADPH", "CO2|CO₂"],
    "min_figures": 1,
    "min_tables": 1,
    "min_chars": 6000
  }
