{
  "id": "bayes_medical_screening",
  "title": "贝叶斯定理与医学筛查",
  "query": "自学贝叶斯定理：公式与含义、医学筛查中的灵敏度/特异度/阳性预测值、基础概率（患病率）如何改变检验结果的含义、基础概率谬误",
  "tier": "smoke",
  "subject": "概率论",
  "preset": "standard",
  "options": {"with_questions": true, "with_diagrams": false, "max_points": 6, "prefer_local_archive": false},
  "expected_knowledge_points": [
    "贝叶斯公式",
    "灵敏度与特异度",
    "阳性预测值与基础概率",
    "基础概率谬误",
    "连续多次检测"
  ],
  "min_unique_sources": 8,
  "expected_domains": ["wikipedia.org", "stat.berkeley.edu", "arxiv.org", "plus.maths.org"],
  "required_facts": [
    {
      "id": "bayes_formula",
      "description": "贝叶斯公式 P(A|B) = P(B|A)P(A) / P(B)",
      "match": {"all": ["贝叶斯"], "any": ["P\\(A\\|B\\)", "P\\(B\\|A\\)", "后验概率.{0,8}先验概率"]},
      "source_urls": ["https://zh.wikipedia.org/wiki/贝叶斯定理"]
    },
    {
      "id": "sensitivity_specificity",
      "description": "灵敏度（患病者中检出阳性比例）与特异度（健康者中检出阴性比例）的定义区分",
      "match": {"all": ["灵敏度"], "any": ["特异度"], "none": []},
      "source_urls": ["https://zh.wikipedia.org/wiki/灵敏度和特异度"]
    },
    {
      "id": "ppv_definition",
      "description": "阳性预测值：阳性者中真正患病的比例，依赖于患病率（基础概率）",
      "match": {"all": ["阳性预测值|PPV"], "any": ["患病率|基础概率|流行率"]},
      "source_urls": ["https://en.wikipedia.org/wiki/Positive_and_negative_predictive_values"]
    },
    {
      "id": "base_rate_effect",
      "description": "低患病率下，即使灵敏度/特异度都很高，阳性预测值也可能很低（假阳性占多数）",
      "match": {"any": ["假阳性.{0,12}(多数|大部分|占多)", "阳性预测值.{0,12}(低|不高)", "基础概率谬误|基础率谬误"]},
      "source_urls": ["https://zh.wikipedia.org/wiki/基础概率谬误"]
    },
    {
      "id": "numeric_example",
      "description": "给出数值演算例子（如患病率 0.1% 时阳性预测值的计算）",
      "match": {"any": ["0.1%|千分之一|1/1000", "1000 ?人", "例如.{0,20}患病率"]},
      "source_urls": ["https://zh.wikipedia.org/wiki/基础概率谬误"]
    },
    {
      "id": "sequential_testing",
      "description": "独立重复检测可提升后验概率（第二次阳性后验显著上升）",
      "match": {"any": ["(重复|二次|连续|再次).{0,4}(检测|检验).{0,12}(后验|概率).{0,4}(升|高|大)", "独立.{0,4}(重复|多次).{0,2}检测"]},
      "source_urls": ["https://en.wikipedia.org/wiki/Bayes%27_theorem"]
    }
  ],
  "traps": [
    {
      "id": "sensitivity_is_ppv",
      "description": "误解：灵敏度 99% 意味着阳性者 99% 真患病（混淆 P(阳性|患病) 与 P(患病|阳性)）",
      "wrong_pattern": "灵敏度.{0,4}(99|高).{0,12}(阳性|检出).{0,4}(就|则|即).{0,4}(99|基本上|大概率).{0,4}(患病|确诊|真)",
      "correct_pattern": "阳性预测值|患病率|基础概率|后验"
    },
    {
      "id": "ignore_base_rate",
      "description": "误解：评价检验准确性可以不看患病率",
      "wrong_pattern": "(不需要|无需|不必).{0,4}(考虑|知道).{0,4}(患病率|基础概率)",
      "correct_pattern": "患病率|基础概率|先验"
    },
    {
      "id": "false_positive_zero",
      "description": "误解：特异度 99% 就意味着几乎没有假阳性",
      "wrong_pattern": "特异度.{0,4}(99|高).{0,8}(就|则|即).{0,4}(几乎)?没有.{0,2}假阳性",
      "correct_pattern": "假阳性率|1%|人群.{0,4}基数|健康人"
    }
  ],
  "contrasts": [
    ["灵敏度", "阳性预测值"],
    ["先验概率", "后验概率"]
  ],
  "format_requirements": {
    "key_formulas": ["P\\(", "\\|", "贝叶斯"],
    "min_figures": 0,
    "min_tables": 1,
    "min_chars": 6000
  }
}
