  "subject": "高中地理",
  "preset": "deep",
  "requirements": "时间与太阳高度计算必须写清经度差换算和方向判断步骤；光照图与公转轨道图须配图解释。",
  "options": {"with_questions": true, "with_diagrams": true, "max_points": 10, "prefer_local_archive": false},
