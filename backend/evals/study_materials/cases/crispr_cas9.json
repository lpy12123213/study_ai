      "correct_pattern": "化学奖"
    },
    {
      "id": "purely_artificial",
      "description": "误解：CRISPR 是完全人工发明的技术（忽视其天然免疫起源）",
      "wrong_pattern": "CRISPR.{0,10}(完全|纯粹|纯).{0,4}人工.{0,4}(发明|合成|设计)",
      "correct_pattern": "细菌|古菌|天然|进化|免疫系统"
    }
  ],
  "contrasts": [
    ["碱基编辑", "引导编辑"],
    ["NHEJ", "HDR"]
  ],
  "format_requirements": {
    "key_formulas": ["PAM", "gRNA|sgRNA", "Cas9"],
